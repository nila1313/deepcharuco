from pathlib import Path
import subprocess
import re

p = Path("run_custom_inference.py")
txt = p.read_text()

deep = subprocess.check_output(
    "ls -t ./tb_logs/ckpts_deepcharuco_pseudo_overfit/*.ckpt | head -1",
    shell=True,
    text=True
).strip()

txt = re.sub(
    r'image_dir = ".*?"',
    'image_dir = "../my_dataset/opencv_pseudolabels_raw_320/images"',
    txt
)

txt = re.sub(
    r'output_img_dir = ".*?"',
    'output_img_dir = "../my_dataset/inference_output_pseudo_overfit/images"',
    txt
)

txt = re.sub(
    r'output_kpt_dir = ".*?"',
    'output_kpt_dir = "../my_dataset/inference_output_pseudo_overfit/keypoints"',
    txt
)

txt = re.sub(
    r'deepc_path = ".*?"',
    f'deepc_path = "{deep}"',
    txt
)

# Important: isolate detector/ID classifier first.
txt = re.sub(
    r'refinenet_path = .*',
    'refinenet_path = None',
    txt
)

p.write_text(txt)

print("Using overfit checkpoint:", deep)
print("Input: ../my_dataset/opencv_pseudolabels_raw_320/images")
print("RefineNet disabled for this sanity test.")
PY
